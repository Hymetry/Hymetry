{
  "name": "hymetry-oss",
  "description": "Self-hosted Hymetry: Session recording, replay, and analytics powered by rrweb",
  "repository": "https://github.com/hymetry/hymetry",
  "website": "https://github.com/hymetry/hymetry",
  "logo": "https://raw.githubusercontent.com/hymetry/hymetry/main/static/svg/logo.svg",
  "keywords": [
    "django",
    "analytics",
    "rrweb",
    "session-replay",
    "celery"
  ],
  "stack": "container",
  "env": {
    "SECRET_KEY": {
      "description": "Persistent Django secret used for sessions and workspace-key encryption.",
      "generator": "secret"
    }
  },
  "addons": [
    "heroku-postgresql:essential-0",
    "heroku-redis:mini"
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
