{
	# Local/dev: never redirect to HTTPS automatically.
	auto_https off
}

:80 {

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	reverse_proxy web:8000
}

