# Django settings
SECRET_KEY=random-string-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
# Database
POSTGRES_DB=hymetry_oss_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pwd
DATABASE_URL=postgresql://postgres:pwd@db:5432/hymetry_oss_db
# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# APP_URL: Optional. Your main application URL (used for asset proxy)
APP_URL=https://yourdomain.com
# EDGE_URL: Optional. URL serving the tracking script (can be same as APP_URL for single-domain setup)
EDGE_URL=https://yourdomain.com
# SITE_URL: Optional. used for CSRF_TRUSTED_ORIGINS and fallback for APP_URL and EDGE_URL 
SITE_URL=https://yourdomain.com
# Caddy
CADDY_HOST=0.0.0.0




