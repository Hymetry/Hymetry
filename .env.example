# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS = [yourdomain.com]
# Database
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=your-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URLs for tracking and asset proxy
# APP_URL: Your main application URL (used for asset proxy)
# EDGE_URL: URL serving the tracking script (can be same as APP_URL for single-domain setup)
APP_URL=https://yourdomain.com
EDGE_URL=https://yourdomain.com
SITE_URL=https://yourdomain.com

# Redis (for Celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0




