# Django settings
SECRET_KEY=replace-with-a-long-random-persistent-secret
# Optional key rotation list. When omitted, BYOK encryption derives a key from SECRET_KEY.
# OPENAI_KEY_ENCRYPTION_KEYS=current-fernet-key,previous-fernet-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=hymetry_oss_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=pwd
DATABASE_URL=postgresql://postgres:pwd@db:5432/hymetry_oss_db
# Set to 0 when using a transaction-mode connection pooler.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Redis and background work
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional shared cache for filtered analytics payloads.
# Use a dedicated Redis database or key prefix in multi-process deployments.
DJANGO_CACHE_URL=redis://redis:6379/2
DJANGO_CACHE_KEY_PREFIX=hymetry
PAGES_FILTERED_OVERVIEW_APPLICATION_CACHE_SECONDS=300

# Optional bounded session replay streaming limits
REPLAY_STREAM_BOOTSTRAP_WINDOW_SECONDS=45
REPLAY_STREAM_BOOTSTRAP_EVENT_LIMIT=3000
REPLAY_STREAM_BOOTSTRAP_MAX_BYTES=2097152
REPLAY_STREAM_CHUNK_WINDOW_SECONDS=60
REPLAY_STREAM_CHUNK_EVENT_LIMIT=5000
REPLAY_STREAM_CHUNK_MAX_BYTES=2097152
REPLAY_STREAM_PREFETCH_THRESHOLD_SECONDS=30
REPLAY_STREAM_APPEND_BATCH_SIZE=250

# HYMETRY_DOMAIN: Optional. Main public URL used for CSRF/host checks and API URL in tracking snippet
HYMETRY_DOMAIN=http://localhost
# EDGE_URL: Optional. URL serving the tracking script (can be same as HYMETRY_DOMAIN for single-domain setup)
EDGE_URL=http://localhost/static/js
# Hosted demo shown in All projects. It is never copied into the OSS database.
HOSTED_DEMO_URL=https://app.hymetry.com/projects/demo/

# Caddy
CADDY_HOST=:80
