# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database
DB_NAME=productpathpro
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# URLs for tracking and asset proxy
# APP_URL: Your main application URL (used for asset proxy)
# EDGE_URL: URL serving the tracking script (can be same as APP_URL for single-domain setup)
APP_URL=https://yourdomain.com
EDGE_URL=https://yourdomain.com
SITE_URL=https://yourdomain.com

# Redis (for Celery)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (Postmark)
POSTMARK_API_TOKEN=your-postmark-token

# Optional: OpenAI
OPENAI_API_KEY=your-openai-key

# Optional: Sentry (for production)
DJANGO_ENV=production

# GitHub deploy (for github-deploy.sh - private repo pull)
GITHUB_DEPLOY_TOKEN=your-github-personal-access-token
